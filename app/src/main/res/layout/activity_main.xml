<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ==================== HOME SCREEN ==================== -->
    <RelativeLayout
        android:id="@+id/homeScreenView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Clock Widget (Long-press to change font) -->
        <LinearLayout
            android:id="@+id/clockContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="H:mm"
                android:includeFontPadding="false"
                android:shadowColor="#99000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="@color/white"
                android:textSize="76sp" />

            <TextClock
                android:id="@+id/clockDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:shadowColor="#99000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="@color/white_semi"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Bottom Search Bar Pill (Tap to open App Drawer) -->
        <LinearLayout
            android:id="@+id/homeSearchBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_search_bar"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Search apps or swipe up..."
                android:textColor="@color/white_semi"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Pinned Home Dock (Favorite Apps) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dockRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/homeSearchBar"
            android:layout_marginBottom="16dp"
            android:overScrollMode="never" />

    </RelativeLayout>

    <!-- ==================== APP DRAWER (M3 BOTTOM SHEET) ==================== -->
    <LinearLayout
        android:id="@+id/appDrawerBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_sheet"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:behavior_skipCollapsed="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- M3 Bottom Sheet Drag Handle -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Drawer Search Bar -->
        <EditText
            android:id="@+id/drawerSearchInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_search_bar"
            android:hint="Search apps..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white_semi"
            android:textSize="15sp" />

        <!-- Full App Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawerRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="32dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>